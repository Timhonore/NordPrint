auto-install-peers=true
strict-peer-dependencies=false
link-workspace-packages=true

# Medusas admin bygges af Vite ud fra en genereret entry.jsx, som importerer
# Medusas egne interne pakker (@medusajs/dashboard, admin-shared, draft-order).
# Med pnpms strikte linkning ligger de kun i .pnpm-butikken, og Rollup kan
# ikke finde dem — admin-buildet fejler med "failed to resolve import".
# At hejse @medusajs/* op i node_modules løser det ét sted i stedet for at
# jage hver enkelt intern pakke, efterhånden som Medusa tilføjer dem.
public-hoist-pattern[]=@medusajs/*
