# NordPrint — miljøvariabler.
#
# Kopiér til .env og udfyld. .env er i .gitignore og må aldrig committes.
#
# Genér hemmeligheder med:
#   openssl rand -base64 48
#
# Værdier markeret [KRÆVES I PRODUKTION] får appen til at nægte at starte,
# hvis de mangler, når NODE_ENV=production. Det er bevidst: en shop, der
# starter uden object storage og gemmer produktbilleder på en efemer disk,
# opdager det først, når containeren genstartes og billederne er væk.

# =============================================================== generelt
NODE_ENV=development

# ============================================================== database
# [KRÆVES I PRODUKTION]
POSTGRES_USER=nordprint
POSTGRES_PASSWORD=skift-mig
POSTGRES_DB=nordprint

# Udvikling: peger på docker-compose.yml. Produktion: sættes af compose-filen.
DATABASE_URL=postgres://nordprint:nordprint@localhost:5432/nordprint

# Sæt til "true" hos hostede udbydere, der kræver TLS til databasen.
DATABASE_SSL=false

# ================================================================= redis
# [KRÆVES I PRODUKTION] — server og worker deler cache, events og locks
# gennem Redis. Uden den kan de to processer ikke koordinere.
REDIS_PASSWORD=skift-mig
REDIS_URL=redis://localhost:6379

# ================================================== hemmeligheder (Medusa)
# [KRÆVES I PRODUKTION] — brug `openssl rand -base64 48` til begge.
# Skift dem aldrig i drift uden varsel: alle sessioner og logins ryger.
JWT_SECRET=dev-only-jwt-secret
COOKIE_SECRET=dev-only-cookie-secret

# ================================================================== CORS
# Kommasepareret. Skal matche de rigtige domæner i produktion — en for bred
# CORS-liste er en åben dør til API'et.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173

# =============================================================== domæner
STOREFRONT_DOMAIN=nordprint.dk
API_DOMAIN=api.nordprint.dk
ADMIN_DOMAIN=admin.nordprint.dk
ACME_EMAIL=drift@nordprint.dk

MEDUSA_BACKEND_URL=http://localhost:9000

# ============================================================ storefront
# NEXT_PUBLIC_* bages ind i klient-bundtet ved build. De kan ikke ændres
# uden at bygge storefront-imaget igen.
NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key. Kun serveren bruger den, så den har bevidst ikke
# NEXT_PUBLIC_-præfiks: den læses ved kørsel og kan skiftes uden at bygge
# storefront-imaget igen. Seed'en skriver den selv til
# apps/storefront/.env.local; i produktion hentes den i Medusa Admin →
# Indstillinger → API-nøgler.
MEDUSA_PUBLISHABLE_KEY=

# Kun "true" på det rigtige produktionsdomæne. Alt andet skal holdes ude af
# Google — et staging-miljø, der bliver indekseret, konkurrerer med butikken.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Værtsnavnet på dit billed-CDN, fx media.nordprint.dk.
NEXT_PUBLIC_IMAGE_HOSTNAME=

# ======================================================== object storage
# [KRÆVES I PRODUKTION] — produktbilleder må ikke ligge på containerens
# disk. Cloudflare R2 i produktion, MinIO lokalt (docker-compose.yml).
#
# R2:    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MinIO: S3_ENDPOINT=http://localhost:9002
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Den offentlige URL, filerne serveres fra (custom domain på bucket'en).
S3_FILE_URL=
S3_FORCE_PATH_STYLE=true

# =============================================================== betaling
# Vipps MobilePay ePayment API. Uden disse registreres MobilePay ikke som
# betalingsmetode — der falder ikke tilbage på en stub.
#
# Test:      https://apitest.vipps.no
# Produktion: https://api.vipps.no
#
# Se docs/payments.md for hvad der mangler, før butikken kan tage imod
# rigtige penge.
VIPPS_MOBILEPAY_CLIENT_ID=
VIPPS_MOBILEPAY_CLIENT_SECRET=
VIPPS_MOBILEPAY_SUBSCRIPTION_KEY=
VIPPS_MOBILEPAY_MSN=
VIPPS_MOBILEPAY_API_URL=https://apitest.vipps.no
VIPPS_MOBILEPAY_RETURN_URL=http://localhost:8000/checkout/retur

# ================================================================= fragt
# Uden nøgler bruger de danske fragtfirmaer udviklings-adapteren. Den
# returnerer pakkeshops med [TEST] i navnet og pakkenumre med TEST-præfiks,
# så ingen forveksler dem med rigtige.
GLS_API_KEY=
DAO_API_KEY=
POSTNORD_API_KEY=

# ================================================================= e-mail
# Uden RESEND_API_KEY logges mails til stdout i stedet for at blive sendt.
RESEND_API_KEY=
EMAIL_FROM=NordPrint <ordre@nordprint.dk>
EMAIL_REPLY_TO=hej@nordprint.dk

# Nyhedsbrev. Uden denne noteres tilmeldinger, men der sendes ingen
# bekræftelse — og kunden får det at vide.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=

# ========================================================== observability
# Sentry eller tilsvarende. Tomt = fejl logges kun til stdout.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=info

# ============================================== forretningsregler (NordPrint)
# Beløb i øre. Ændres her — aldrig i koden.
NORDPRINT_FREE_SHIPPING_THRESHOLD=49900
NORDPRINT_DEFAULT_SHIPPING_RATE=4900
NORDPRINT_SHOW_FREE_SHIPPING_PROGRESS=true

# Lagergrænser: over 5 = "På lager", 1-5 = "Kun få tilbage", 0 = "Udsolgt".
NORDPRINT_STOCK_IN_STOCK_ABOVE=5
NORDPRINT_STOCK_LOW_AT_OR_BELOW=5
NORDPRINT_ALLOW_BACKORDER=false

NORDPRINT_VAT_RATE=0.25
NORDPRINT_PRICES_INCLUDE_VAT=true
NORDPRINT_COUNTRIES=dk
NORDPRINT_DEFAULT_COUNTRY=dk
NORDPRINT_MAX_COMPARE_ITEMS=4
NORDPRINT_PRODUCTS_PER_PAGE=24

# USP'er som JSON. Udeladt = standardteksterne i @nordprint/config.
# NORDPRINT_USPS=[{"id":"fast","title":"Hurtig levering","description":"…","icon":"truck"}]

# ================================================== firmaoplysninger (footer)
NORDPRINT_SUPPORT_EMAIL=hej@nordprint.dk
NORDPRINT_SUPPORT_PHONE=+45 00 00 00 00
NORDPRINT_CVR=00000000
NORDPRINT_ADDRESS_STREET=Printervej 1
NORDPRINT_ADDRESS_POSTAL_CODE=8000
NORDPRINT_ADDRESS_CITY=Aarhus C
NORDPRINT_ADDRESS_COUNTRY=DK
NORDPRINT_SOCIAL_URLS=

# ================================================================ backup
BACKUP_RETENTION_DAYS=14
# Off-site kopi. Uden dette ligger backuppen KUN på den server, den beskytter.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
